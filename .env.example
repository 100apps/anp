# 请运行 make init 生成私有 .env。凭据不要提交。
ANP3_IMAGE=anp3/toolbox:local
ANP3_SERVICES=all
ANP3_AUTO_DEPS=1
ANP3_MEMORY_MB=16384
ANP3_CPU_THREADS=8
ANP3_PUBLIC_URL=http://127.0.0.1:51760
# Windows Docker Desktop 使用 Linux 主机目录；Linux 可改为 /srv/anp3/data。
ANP_DATA_ROOT=/var/lib/anp3/data
BUSINESS_PORT=20260
PG_PORT=57432
REDIS_PORT=57379
CH_PORT=59223
CH_NATIVE_PORT=59400
S3_API_PORT=59402
S3_CONSOLE_PORT=59403
DBX_PORT=54424
LANGFUSE_PORT=53400
LITELLM_PORT=54400
STUDIO_PORT=53401
SUPABASE_API_PORT=58400
HEALTH_PORT=57501
