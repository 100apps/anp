{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "debugpy",
      "request": "launch",
      "module": "anp.dev.v3",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true,
      "envFile": "${workspaceFolder}/.local/generated/platform-v3/business.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}"
      },
      "presentation": {
        "hidden": true
      },
      "name": "ANP V3: API 热重载调试",
      "args": [
        "api"
      ]
    },
    {
      "type": "debugpy",
      "request": "launch",
      "module": "anp.dev.v3",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true,
      "envFile": "${workspaceFolder}/.local/generated/platform-v3/business.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}"
      },
      "presentation": {
        "hidden": true
      },
      "name": "ANP V3: Worker 热重载调试",
      "args": [
        "worker"
      ]
    },
    {
      "name": "ANP V3: 平台源码调试",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5684
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/mnt/e/anp"
        }
      ],
      "justMyCode": false,
      "subProcess": true,
      "preLaunchTask": "anp:v3:native-runtime",
      "postDebugTask": "anp:v3:stop-native",
      "presentation": {
        "hidden": true
      },
      "clientOS": "windows"
    },
    {
      "name": "ANP V3: 前端热更新调试",
      "type": "pwa-msedge",
      "request": "launch",
      "url": "${config:anp.platformUrl}/workbench/",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "*/workbench/src/*": "${workspaceFolder}/console/src/*",
        "*/workbench/@fs/*": "*"
      },
      "userDataDir": "${workspaceFolder}/.local/edge-v3-debug-profile",
      "preLaunchTask": "anp:v3:frontend-ready",
      "presentation": {
        "hidden": true
      }
    },
    {
      "type": "debugpy",
      "request": "launch",
      "module": "anp.cli.entry",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true,
      "envFile": "${workspaceFolder}/.local/generated/platform-v3/business.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}"
      },
      "name": "ANP V3: 默认本地 CLI 调试",
      "args": [
        "demo",
        "tasks",
        "list"
      ]
    }
  ],
  "compounds": [
    {
      "name": "ANP V3: F5 业务（Docker 平台）",
      "configurations": [
        "ANP V3: API 热重载调试",
        "ANP V3: Worker 热重载调试",
        "ANP V3: 前端热更新调试"
      ],
      "preLaunchTask": "anp:v3:prepare-docker",
      "stopAll": true
    },
    {
      "name": "ANP V3: F5 业务 + 平台（WSL 源码）",
      "configurations": [
        "ANP V3: 平台源码调试",
        "ANP V3: API 热重载调试",
        "ANP V3: Worker 热重载调试",
        "ANP V3: 前端热更新调试"
      ],
      "preLaunchTask": "anp:v3:prepare-native",
      "stopAll": true
    }
  ]
}
