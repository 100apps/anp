{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ANP: Python 后端（热重载）",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 56796
      },
      "justMyCode": true,
      "subProcess": true,
      "postDebugTask": "ANP: 停止开发"
    },
    {
      "name": "ANP: 工作台前端",
      "type": "pwa-msedge",
      "request": "launch",
      "url": "http://127.0.0.1:51760/workbench/",
      "webRoot": "${workspaceFolder}/business/ui",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "vite:///*": "${webRoot}/*"
      },
      "timeout": 90000,
      "pathMapping": {
        "/workbench": "${workspaceFolder}/business/ui"
      }
    }
  ],
  "compounds": [
    {
      "name": "ANP: 一键前后端热重载",
      "configurations": [
        "ANP: Python 后端（热重载）"
      ],
      "preLaunchTask": "ANP: 准备调试",
      "stopAll": true
    },
    {
      "name": "ANP: 前后端与浏览器调试（需Edge）",
      "configurations": [
        "ANP: Python 后端（热重载）",
        "ANP: 工作台前端"
      ],
      "preLaunchTask": "ANP: 准备调试",
      "stopAll": true
    }
  ]
}
