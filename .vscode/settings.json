{
  "python.defaultInterpreterPath": "${workspaceFolder}/business/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/business/src"
  ],
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "platform/sources": true,
    "var": true
  },
  "files.watcherExclude": {
    "**/platform/sources/**": true,
    "**/var/**": true,
    "**/.venv/**": true
  },
  "debug.javascript.autoAttachFilter": "disabled"
}
