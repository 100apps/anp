{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["${workspaceFolder}/src", "${workspaceFolder}"],
  "python.terminal.activateEnvironment": true,
  "files.exclude": {"**/__pycache__": true, ".local/cache": true},
  "files.watcherExclude": {"**/.venv/**":true,"**/node_modules/**":true,"**/.local/**":true},
  "search.exclude": {".venv":true,"node_modules":true,".local":true,"console/dist":true},
  "debug.onTaskErrors": "abort",
  "debug.internalConsoleOptions": "neverOpen",
  "editor.formatOnSave": true,
  "[python]": {"editor.tabSize":4},
  "[typescriptreact]": {"editor.tabSize":2},
  "terminal.integrated.defaultProfile.windows": "PowerShell"
}
