{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ANP2: 准备依赖与四存储",
      "type": "process",
      "command": "python",
      "args": [
        "scripts/manage.py",
        "prepare"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ANP2: 前端 HMR",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--project",
        "business",
        "python",
        "${workspaceFolder}/scripts/dev.py",
        "frontend"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "anp2-frontend",
        "pattern": {
          "regexp": "^(?!)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "ANP2_FRONTEND_START",
          "endsPattern": "ANP2_FRONTEND_READY"
        }
      }
    },
    {
      "label": "ANP2: 后端 HMR 与调试",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--project",
        "business",
        "python",
        "${workspaceFolder}/scripts/dev.py",
        "backend-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "anp2-backend",
        "pattern": {
          "regexp": "^(?!)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "ANP2_BACKEND_START",
          "endsPattern": "ANP2_BACKEND_READY"
        }
      }
    },
    {
      "label": "ANP2: 准备调试",
      "dependsOrder": "sequence",
      "dependsOn": [
        "ANP2: 准备依赖与四存储",
        "ANP2: 前端 HMR",
        "ANP2: 后端 HMR 与调试"
      ],
      "problemMatcher": []
    },
    {
      "label": "ANP2: 停止开发",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--project",
        "business",
        "python",
        "${workspaceFolder}/scripts/dev.py",
        "stop"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
