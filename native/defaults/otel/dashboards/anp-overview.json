{
  "uid": "anp-overview",
  "title": "ANP 业务观测",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP 请求速率",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "anp-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(anp_http_server_requests_total[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP P95 延迟",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "anp-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(anp_http_server_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 3,
      "title": "业务日志",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "anp-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"anp-business\"}"
        }
      ]
    }
  ]
}
